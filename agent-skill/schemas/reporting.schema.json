{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic report configuration v1",
  "type": "object",
  "required": [
    "version",
    "timeZone",
    "today",
    "canConfigure",
    "templates"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "today": {
      "type": "string",
      "format": "date"
    },
    "canConfigure": {
      "type": "boolean"
    },
    "templates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": [
            "text",
            "multiline",
            "number",
            "date",
            "select"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "name",
        "cadence",
        "enabled",
        "revision",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "cadence": {
          "enum": [
            "DAILY",
            "WEEKLY",
            "MONTHLY"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "canWrite": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
