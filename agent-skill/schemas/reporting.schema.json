{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic report configuration v1",
  "type": "object",
  "required": [
    "version",
    "timeZone",
    "today",
    "canConfigure",
    "templates"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "today": {
      "type": "string",
      "format": "date"
    },
    "canConfigure": {
      "type": "boolean"
    },
    "templates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "section": {
          "type": "string",
          "maxLength": 80
        },
        "type": {
          "enum": [
            "text",
            "multiline",
            "number",
            "date",
            "select",
            "table"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/column" }
        },
        "minRows": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 100 },
        "initialRows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string", "maxLength": 2000 },
                { "type": "number" },
                { "type": "null" }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "table" }
            }
          },
          "then": {
            "required": ["columns"],
            "properties": {
              "maxRows": { "type": "integer", "minimum": 1, "maximum": 100 },
              "minRows": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          }
        }
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "enum": ["text", "number"] },
        "required": { "type": "boolean" }
      }
    },
    "submissionWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "reportPeriod"],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [{ "const": "SATURDAY" }, { "const": "SUNDAY" }],
          "items": false
        },
        "reportPeriod": { "enum": ["PREVIOUS_WEEK"] }
      }
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "name",
        "cadence",
        "enabled",
        "revision",
        "canWrite",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "cadence": {
          "enum": [
            "DAILY",
            "WEEKLY",
            "MONTHLY"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "canWrite": {
          "type": "boolean"
        },
        "writeWindowOpen": { "type": "boolean" },
        "submissionWindow": { "$ref": "#/$defs/submissionWindow" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "submissionWindow": { "type": "object" } } },
          "then": { "required": ["writeWindowOpen"], "properties": { "cadence": { "const": "WEEKLY" } } }
        }
      ]
    }
  }
}
