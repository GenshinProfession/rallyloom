{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider task board definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statuses",
    "defaultStatus",
    "fields"
  ],
  "properties": {
    "defaultStatus": {
      "type": "string",
      "minLength": 1
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "dot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "dot": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "category": {
            "enum": [
              "pending",
              "active",
              "completed"
            ]
          },
          "transitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "text",
              "number",
              "date",
              "select"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
