{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rallyloom/ingest/notice-push/v1",
  "title": "notice.push — 通知中心公告承接",
  "description": "公告数据由外部系统推送，Rallyloom 挂办公室顶部横幅并展示于通知中心；幂等锚点 source_id + external_notice_id。",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "items"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$", "maxLength": 64, "description": "推送方在 Rallyloom 登记的源标识" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_notice_id", "title"],
        "properties": {
          "external_notice_id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "幂等锚点：同 ID 重推原地刷新，绝不产生重复公告" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "maxLength": 500 },
          "level": { "enum": ["info", "warning", "urgent"], "description": "展示级别；缺省 info" },
          "url": { "type": "string", "maxLength": 512, "description": "详情链接（可选）" },
          "pinned": { "type": "boolean", "description": "置顶横幅优先展示；置顶状态由超管可撤，不回写源系统" },
          "occurred_at": { "type": "string", "format": "date-time" },
          "attrs": {
            "type": "object",
            "description": "自由属性（中性容器）：仓库、批次、范围等；禁止塞权限语义",
            "maxProperties": 32,
            "additionalProperties": { "type": "string", "maxLength": 512 }
          }
        }
      }
    }
  }
}
