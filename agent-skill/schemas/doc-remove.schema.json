{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rallyloom/ingest/doc-remove/v1",
  "title": "doc.remove — 文档下架",
  "description": "下架一篇文档；幂等：下架不存在的文档返回成功。",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "external_doc_id"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$", "maxLength": 64 },
    "external_doc_id": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
